# Version testée et volontairement figée pour des démarrages reproductibles.
N8N_VERSION=2.41.3

# Le port est publié uniquement sur 127.0.0.1 par compose.yaml.
N8N_HOST_PORT=5678
GENERIC_TIMEZONE=Europe/Paris

# Compte propriétaire créé seulement lors de la première initialisation.
N8N_OWNER_EMAIL=admin@local.test
N8N_OWNER_FIRST_NAME=Admin
N8N_OWNER_LAST_NAME=Local
N8N_OWNER_PASSWORD=Admin123

# Le script de démarrage remplace cette valeur dans le fichier .env local.
N8N_ENCRYPTION_KEY=GENERATED_BY_START_SCRIPT
